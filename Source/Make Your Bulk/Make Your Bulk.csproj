<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>

		<DebugType>embedded</DebugType>
		
		<AssemblyName>MakeYourBulk</AssemblyName>
		<RootNamespace>MakeYourBulk</RootNamespace>
		<Authors>AlenDio</Authors>
		
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<Configurations>1.7;1.6;1.5</Configurations>
		
		<RWVersion Condition="'$(RWVersion)' == ''">1.7</RWVersion>
		<RWVersion Condition="'$(Configuration)' == '1.6'">1.6</RWVersion>
		<RWVersion Condition="'$(Configuration)' == '1.5'">1.5</RWVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RWVersion)' == '1.7'">
		<TargetFramework>net10.0</TargetFramework>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
		<DefineConstants>RW_17</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RWVersion)' == '1.6'">
		<OutputPath>..\..\1.6\Assemblies\</OutputPath>
		<DefineConstants>RW_16</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RWVersion)' == '1.5'">
		<OutputPath>..\..\1.5\Assemblies\</OutputPath>
		<DefineConstants>RW_15</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(RWVersion)' == '1.7'">
		<Reference Include="Assembly-CSharp">
			<HintPath></HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(RWVersion)' == '1.6'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup Condition="'$(RWVersion)' == '1.5'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.*" PrivateAssets="All" />
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DeepCloner" Version="0.10.4" ExcludeAssets="runtime" />
		<PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
	</ItemGroup>
	
	<Target Name="PrintVersionMessage" BeforeTargets="Build">
		<Message Text="&gt; $(AssemblyName) for RimWorld $(RWVersion)" Importance="high" />
	</Target>

</Project>
